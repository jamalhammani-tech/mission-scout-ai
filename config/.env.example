# Copier ce fichier en .env et renseigner les valeurs réelles.
# Ne jamais committer .env (voir .gitignore).

# Clé API du fournisseur LLM utilisé par les agents
# ANTHROPIC_API_KEY=

# memory-agent — moteur de base de données (SQLAlchemy). PostgreSQL via docker-compose.yml
# (SQLite est réservé aux tests unitaires). Voir docs/adr/0002-postgresql-docker-compose.md
# DATABASE_URL=postgresql+psycopg://memory_agent:memory_agent@localhost:5432/memory_agent

# Identifiants du service postgres de docker-compose.yml (valeurs par défaut ci-dessous si absentes)
# POSTGRES_USER=memory_agent
# POSTGRES_PASSWORD=memory_agent
# POSTGRES_DB=memory_agent
# POSTGRES_PORT=5432

# Configuration à compléter au fur et à mesure de l'implémentation des agents
